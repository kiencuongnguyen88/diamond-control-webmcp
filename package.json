{
  "name": "diamond-control-webmcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "build:test": "node scripts/build-test.mjs",
    "build": "node scripts/build.mjs",
    "lint": "node scripts/lint.mjs",
    "verify": "npm run typecheck && npm run build:test && npm run test && npm run lint && npm run build",
    "serve": "node scripts/serve.mjs"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
